{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jmmana/sqlguardllm/main/schema/policy-tests.schema.json",
  "title": "sqlguardllm policy test cases",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sql",
          "expect"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "sql": {
            "type": "string",
            "pattern": "\\S"
          },
          "role": {
            "type": "string",
            "pattern": "\\S",
            "description": "Required when testing a policy set."
          },
          "context": {
            "type": "object",
            "description": "Values for row filters."
          },
          "expect": {
            "enum": [
              "allow",
              "reject"
            ]
          },
          "violation": {
            "enum": [
              "parse_error",
              "empty_statement",
              "multiple_statements",
              "not_a_query",
              "write_operation",
              "row_lock",
              "table_not_allowed",
              "hidden_column",
              "denied_function",
              "missing_context",
              "invalid_context",
              "too_complex",
              "missing_required_filter",
              "aggregate_required",
              "audit_failure"
            ]
          },
          "sql_contains": {
            "type": "string",
            "minLength": 1,
            "description": "A literal, case-sensitive substring of rewritten SQL."
          }
        },
        "if": {
          "properties": {
            "expect": {
              "const": "allow"
            }
          }
        },
        "then": {
          "not": {
            "required": [
              "violation"
            ]
          }
        },
        "else": {
          "not": {
            "required": [
              "sql_contains"
            ]
          }
        }
      }
    }
  }
}
