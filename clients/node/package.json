{
  "name": "sqlguardllm",
  "version": "0.1.0",
  "description": "Official Node.js/TypeScript client for the sqlguardllm SQL firewall server",
  "license": "MIT",
  "repository": {"type": "git", "url": "git+https://github.com/jmmana/sqlguardllm.git", "directory": "clients/node"},
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {".": {"import": {"types": "./dist/index.d.ts", "default": "./dist/index.js"}, "require": {"types": "./dist/index.d.cts", "default": "./dist/index.cjs"}}},
  "files": ["dist", "README.md"],
  "engines": {"node": ">=18"},
  "sideEffects": false,
  "keywords": ["sql", "llm", "firewall", "security", "text-to-sql"],
  "scripts": {"build": "tsup", "typecheck": "tsc --noEmit", "test": "vitest run"},
  "devDependencies": {"@types/node": "^22.0.0", "tsup": "^8.3.0", "typescript": "^5.6.0", "vitest": "^2.1.0"}
}
