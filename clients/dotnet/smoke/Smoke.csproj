<Project Sdk="Microsoft.NET.Sdk">
  <!-- Consumes the PACKED SqlGuardLlm package (clients/dotnet/out), the way a user does. Not part of SqlGuardLlm.sln.
       Restore with the version just packed: dotnet publish -p:SqlGuardLlmVersion=0.5.0-alpha.5 -r <rid> ... -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SqlGuardLlmVersion Condition="'$(SqlGuardLlmVersion)' == ''">0.5.0-alpha.5</SqlGuardLlmVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <PackageReference Include="SqlGuardLlm" Version="$(SqlGuardLlmVersion)" />
  </ItemGroup>
</Project>
